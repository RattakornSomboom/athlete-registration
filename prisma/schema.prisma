generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================
// Enums
// =============================================

enum Role {
  ATHLETE
  CLUB
  STAFF
  ADMIN
}

enum StudentLevel {
  BACHELOR
  GRADUATE
}

enum ApplicationStatus {
  SUBMITTED
  CLUB_APPROVED
  CLUB_REJECTED
  STAFF_APPROVED
  STAFF_REJECTED
  FINAL_SELECTED
}

enum CompetitionStatus {
  OPEN
  CLOSED
  COMPLETED
}

// =============================================
// Models
// =============================================

model User {
  id        String   @id @default(cuid())
  studentId String   @unique
  email     String   @unique
  password  String
  role      Role     @default(ATHLETE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile      AthleteProfile?
  applications Application[]
}

model AthleteProfile {
  id            String       @id @default(cuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName     String
  lastName      String
  faculty       String
  major         String
  studentLevel  StudentLevel @default(BACHELOR)
  year          String
  nationalId    String
  nationality   String       @default("ไทย")
  birthDate     DateTime
  gpaSemester   String?
  gpaCumulative String?
  addressNo     String
  subDistrict   String
  district      String
  province      String
  postalCode    String
  phone         String
  photoUrl      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Club {
  id        String   @id @default(cuid())
  name      String   @unique
  sport     String
  email     String   @unique
  password  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  competitions Competition[]
  activities   Activity[]
}

model Competition {
  id        String            @id @default(cuid())
  clubId    String
  club      Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name      String
  sport     String
  round     String
  year      Int
  status    CompetitionStatus @default(OPEN)
  createdAt DateTime          @default(now())

  applications Application[]
}

model Application {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  competitionId String
  competition   Competition       @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  sport         String
  category      String
  division      String?
  status        ApplicationStatus @default(SUBMITTED)
  note          String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  statusHistory      StatusHistory[]
  sportEntries       SportEntry[]
  competitionResults CompetitionResult[]
}

model SportEntry {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  sport         String
  category      String
  division      String?
}

model CompetitionResult {
  id              String      @id @default(cuid())
  applicationId   String
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  competitionName String
  year            String
  result          String
}

model StatusHistory {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        String
  label         String
  by            String
  createdAt     DateTime    @default(now())
}

model Activity {
  id          String   @id @default(cuid())
  clubId      String
  club        Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  title       String
  description String?
  date        DateTime
  location    String?
  status      String   @default("planned")
  createdAt   DateTime @default(now())
}
