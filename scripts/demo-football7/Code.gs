function setKpiCard(sheet, rangeA1, title, value, colorHex) {
  var range = sheet.getRange(rangeA1);
  range.merge();
  range.setValue(title + "\n" + value);
  range.setBackground(colorHex);
  range.setFontColor("#FFFFFF");
  range.setFontWeight("bold");
  range.setHorizontalAlignment("center");
  range.setVerticalAlignment("middle");
  range.setWrap(true);
}

/**
 * Web App entry point. Deploy this bound Apps Script as a web app after
 * running setupFootball7DatasetAndDashboard once in its Google Sheet.
 */
function doGet() {
  return HtmlService.createHtmlOutputFromFile("Index")
    .setTitle("Football 7 Performance Dashboard")
}

/**
 * Reads the current workbook data so the web app reflects Google Sheet edits.
 * The function deliberately returns only dashboard-safe, mock athlete data.
 */
function getDashboardData() {
  var spreadsheetId = PropertiesService.getScriptProperties().getProperty("FOOTBALL7_SPREADSHEET_ID");
  if (!spreadsheetId) {
    throw new Error("ยังไม่ได้ตั้งค่าข้อมูลตัวอย่าง: ให้รัน setupFootball7DatasetAndDashboard ก่อน Deploy Web App");
  }

  var ss = SpreadsheetApp.openById(spreadsheetId);
  var athletes = rowsAsObjects_(ss.getSheetByName("นักกีฬา"));
  var fitness = rowsAsObjects_(ss.getSheetByName("สมรรถภาพ"));
  var history = rowsAsObjects_(ss.getSheetByName("ผลงานย้อนหลัง"));
  var matches = rowsAsObjects_(ss.getSheetByName("ผลการแข่งขัน"));
  var development = rowsAsObjects_(ss.getSheetByName("เป้าหมายและแผนพัฒนา"));

  var preFitness = {};
  var postFitness = {};
  fitness.forEach(function(row) {
    var id = row["รหัสนักกีฬา"];
    var score = asNumber_(row["คะแนนรวม (เต็ม 100)"]);
    if (row["ช่วงเวลาทดสอบ"] === "ก่อนแข่ง (Pre-Comp)") preFitness[id] = score;
    if (row["ช่วงเวลาทดสอบ"] === "หลังแข่ง (Post-Comp)") postFitness[id] = score;
  });

  var historyByAthlete = indexBy_(history, "รหัสนักกีฬา");
  var developmentByAthlete = indexBy_(development, "รหัสนักกีฬา");
  var matchStats = {};
  matches.forEach(function(row) {
    var id = row["รหัสนักกีฬา"];
    if (!matchStats[id]) matchStats[id] = { minutes: 0, goals: 0, assists: 0, ratings: [] };
    matchStats[id].minutes += asNumber_(row["นาทีที่ลงเล่น"]);
    matchStats[id].goals += asNumber_(row["ประตู"]);
    matchStats[id].assists += asNumber_(row["แอสซิสต์"]);
    matchStats[id].ratings.push(asNumber_(row["คะแนนความสามารถ (เต็ม 10)"]));
  });

  return athletes.map(function(athlete) {
    var id = athlete["รหัสนักกีฬา"];
    var previous = historyByAthlete[id] || {};
    var plan = developmentByAthlete[id] || {};
    var stat = matchStats[id] || { minutes: 0, goals: 0, assists: 0, ratings: [] };
    var rating = stat.ratings.length
      ? Math.round((stat.ratings.reduce(function(sum, value) { return sum + value; }, 0) / stat.ratings.length) * 10) / 10
      : null;

    return {
      id: id,
      name: athlete["ชื่อ-นามสกุล"],
      position: athlete["ตำแหน่งหลัก"],
      squad: athlete["สถานะในทีม"].indexOf("ตัวจริง") === 0 ? "ตัวจริง" : "ตัวสำรอง",
      tier: previous["ระดับการแข่งขัน (Tier)"] || "ยังไม่มีข้อมูล",
      history: asNumber_(previous["คะแนนผลงานย้อนหลัง"]),
      pre: preFitness[id] || 0,
      post: postFitness[id] || 0,
      minutes: stat.minutes,
      goals: stat.goals,
      assists: stat.assists,
      rating: rating,
      target: normalizeTarget_(plan["การบรรลุเป้าหมาย"]),
      readiness: readinessFromTarget_(plan["การบรรลุเป้าหมาย"], stat.minutes),
      goal: plan["เป้าหมายก่อนแข่ง"] || "ยังไม่มีเป้าหมายที่บันทึกไว้",
      actual: plan["ผลการแข่งขันจริง"] || "ยังไม่มีผลการแข่งขันที่บันทึกไว้",
      strength: plan["จุดแข็งที่พบจากเกมจริง"] || "ยังไม่มีข้อมูล",
      gap: plan["จุดที่ต้องแก้ไข/ช่องว่าง"] || "ยังไม่มีข้อมูล",
      plan: plan["แผนพัฒนาเฉพาะบุคคล (Next Action Plan)"] || "ยังไม่มีแผนพัฒนา"
    };
  });
}

function rowsAsObjects_(sheet) {
  if (!sheet) throw new Error("ไม่พบแท็บข้อมูลที่จำเป็นใน Google Sheet");
  var values = sheet.getDataRange().getValues();
  var headers = values.shift();
  return values.filter(function(row) {
    return row.some(function(value) { return value !== ""; });
  }).map(function(row) {
    return headers.reduce(function(record, header, index) {
      record[header] = row[index];
      return record;
    }, {});
  });
}

function indexBy_(rows, key) {
  return rows.reduce(function(index, row) {
    index[row[key]] = row;
    return index;
  }, {});
}

function asNumber_(value) {
  var number = Number(value);
  return isNaN(number) ? 0 : number;
}

function normalizeTarget_(value) {
  if (!value) return "รอประเมิน";
  if (value.indexOf("เกินเป้าหมาย") === 0) return "เกินเป้าหมาย";
  if (value.indexOf("บรรลุเป้าหมาย") === 0) return "บรรลุเป้าหมาย";
  if (value.indexOf("เกือบสำเร็จ") === 0) return "เกือบสำเร็จ";
  if (value.indexOf("ไม่ถึงเป้าหมาย") === 0) return "ไม่ถึงเป้าหมาย";
  return "รอประเมิน";
}

function readinessFromTarget_(value, minutes) {
  if (!minutes) return "เสริมเกมอุ่นเครื่อง";
  if (value && value.indexOf("เกินเป้าหมาย") === 0) return "แกนหลักตัวเต็ง";
  if (value && value.indexOf("ไม่ถึงเป้าหมาย") === 0) return "ต้องพัฒนาตามแผน";
  if (value && value.indexOf("เกือบสำเร็จ") === 0) return "ติดตามเฉพาะด้าน";
  return "พร้อมแข่งขันสูง";
}



